########################################
# RedisJS .env
########################################

# TCP (non-TLS) port
REDISJS_PORT=6379
# Monitor UI HTTP port (unset to disable)
REDISJS_MONITOR_PORT=8128
# Default user password (enables AUTH)
# REDISJS_PASSWORD=redisjs
# Role at start: master|replica
# REDISJS_ROLE=master
# PSYNC backlog bytes
# REDISJS_REPL_BACKLOG_BYTES=1048576

# AOF: set to 0/false to disable
REDISJS_AOF=0
# AOF file
REDISJS_AOF_FILE=aof.log
# Snapshot file
REDISJS_SNAPSHOT_FILE=dump.json
# Slowlog threshold (µs)
REDISJS_SLOWLOG_THRESHOLD_US=1000
# Keyspace notifications flags (e.g. KEA)
REDISJS_NOTIFY_KEYSPACE_EVENTS=KEA


########################################
# TLS (optional)
########################################

# TLS port
# REDISJS_TLS_PORT=6380

# PFX bundle
# REDISJS_TLS_PFX_FILE=certs/server.pfx
# REDISJS_TLS_PFX_PASSPHRASE=

# PEM key/cert
# REDISJS_TLS_KEY_FILE=certs/server.key
# REDISJS_TLS_CERT_FILE=certs/server.crt
# REDISJS_TLS_CA_CERT_FILE=certs/ca.crt

# Inline PEM (not for prod)
# REDISJS_TLS_KEY=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
# REDISJS_TLS_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# REDISJS_TLS_CA=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

# Client certs required (mTLS): yes|no
# REDISJS_TLS_AUTH_CLIENTS=no
# TLS versions
# REDISJS_TLS_MIN_VERSION=TLSv1.2
# REDISJS_TLS_MAX_VERSION=TLSv1.3
# OpenSSL cipher list
# REDISJS_TLS_CIPHERS=
